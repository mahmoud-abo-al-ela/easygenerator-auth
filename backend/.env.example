# Copy to .env and adjust. All variables are validated at startup (src/config/env.validation.ts).
# Defaults to production when unset (Secure cookies). Use development locally over plain HTTP.
NODE_ENV=development
PORT=3000

# Local Mongo from `docker compose up -d` at the repo root
MONGODB_URI=mongodb://localhost:27017/easygenerator-auth

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
# Session length in seconds (min 60); also used as the cookie max-age
JWT_EXPIRES_IN_SECONDS=3600

# Frontend origin allowed to send credentialed requests
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app (0 = none). Set 1 behind a single
# load balancer so rate limits use the client IP. Never set more than the real count.
TRUST_PROXY_HOPS=0
